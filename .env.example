NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173,http://192.168.1.17:5173
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=RootPass@2026
MYSQL_USER=app_user
MYSQL_PASSWORD=AppPass@2026
MYSQL_DATABASE=task_manager

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=replace_with_a_strong_access_secret
JWT_REFRESH_SECRET=replace_with_a_strong_refresh_secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

GEMINI_API_KEY=replace_with_gemini_key
GEMINI_MODEL=gemini-1.5-flash

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=product_knowledge_v1
# optional
QDRANT_API_KEY=
EMBEDDING_VECTOR_SIZE=1536
OPEN_API_KEY=test